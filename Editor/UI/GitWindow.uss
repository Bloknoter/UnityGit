/* UnityGit window layout.
   Colours, type and controls come from the vendored EditorUI kit (Theme/EditorDarkTheme.uss), which GitWindowView
   applies. This sheet only sizes and places things, with the kit's --ed-* variables. GitWindowView adds it after the
   theme on the same element, so it wins ties; kit rules are overridden with ".unitygit-window ..." selectors that are
   at least as specific as the kit's ".ed-root ...". */

.unitygit-window {
    flex-grow: 1;
}

/* Toolbar: the kit's toolbar row (.ed-toolbar) holding kit buttons, with its panel removed (owner request). */
.unitygit-window #unitygit-toolbar {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    padding-left: 0;
    padding-right: 0;
}

#unitygit-toolbar > .unity-button {
    height: 22px;
    margin-left: var(--ed-space-1);
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 0;
}

#unitygit-toolbar > #unitygit-commit-button {
    margin-left: 0;
}

#unitygit-toolbar > #unitygit-fetch-button {
    margin-left: var(--ed-space-3);
}

#unitygit-branch-menu {
    min-width: 120px;
    height: 22px;
    margin-left: 0;
    margin-right: var(--ed-space-3);
    margin-top: 0;
    margin-bottom: 0;
    padding-left: var(--ed-space-2);
    padding-right: var(--ed-space-1);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-top-left-radius: var(--ed-radius-s);
    border-top-right-radius: var(--ed-radius-s);
    border-bottom-left-radius: var(--ed-radius-s);
    border-bottom-right-radius: var(--ed-radius-s);
}

#unitygit-branch-menu > .unity-toolbar-menu__text {
    -unity-font-style: bold;
}

#unitygit-progress {
    margin-right: var(--ed-space-1);
    -unity-text-align: middle-right;
}

/* Action icons: white PNGs (GitIcons) tinted like the text they sit before. Button.iconImage puts an
   Image.unity-button__image before the button's text; GitIcons puts an Image.unitygit-icon before a menu's text.
   The tints follow the kit's button text colours, in the kit's order: text, muted when disabled, on-accent on
   primary buttons (the kit keeps a disabled primary button's text on-accent, and its menu text unchanged).
   A disabled control is faded by Unity's theme (0.5 opacity on the whole control), so the icon fades with its
   label. IconTests.IconTint_ReadsLikeLabel_EnabledAndDisabled checks this with resolved styles. */

.unitygit-window .unity-button.unity-button--with-icon {
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.unitygit-window .unity-button > .unity-button__image,
.unitygit-window .unitygit-icon {
    flex-shrink: 0;
    width: 16px;
    height: 16px;
    margin-left: 0;
    margin-right: var(--ed-space-1);
    margin-top: 0;
    margin-bottom: 0;
    --unity-image-tint-color: var(--ed-text);
}

.unitygit-window .unity-button:disabled > .unity-button__image {
    --unity-image-tint-color: var(--ed-text-muted);
}

.unitygit-window .unity-button.ed-button--primary > .unity-button__image {
    --unity-image-tint-color: var(--ed-text-on-accent);
}

/* Outcome: a kit message whose text column also holds the conflicts and Details foldouts. */

.unitygit-outcome-content {
    flex-grow: 1;
    flex-shrink: 1;
}

.unitygit-outcome-content > .unity-foldout {
    margin-top: var(--ed-space-1);
}

.unitygit-outcome-details {
    white-space: normal;
}

.unitygit-window .unitygit-outcome-resolve {
    align-self: flex-start;
    margin-left: 0;
    margin-right: 0;
    margin-top: var(--ed-space-1);
    margin-bottom: 0;
}

/* Body: a centred card for No repository / Git missing / Git can't open it / Loading, else the nav and the panel. */

.unitygit-body {
    flex-grow: 1;
}

.unitygit-window .unitygit-state-card {
    align-self: center;
    width: 100%;
    max-width: 440px;
    margin-top: var(--ed-space-4);
}

.unitygit-window .unitygit-state-card > .ed-card__content {
    align-items: flex-start;
    padding-left: var(--ed-space-4);
    padding-right: var(--ed-space-4);
    padding-top: var(--ed-space-4);
    padding-bottom: var(--ed-space-4);
}

.unitygit-state-message {
    white-space: normal;
    font-size: var(--ed-font-l);
    margin-bottom: var(--ed-space-3);
    padding-left: 0;
    padding-right: 0;
}

.unitygit-state-details {
    white-space: normal;
    padding-left: 0;
    padding-right: 0;
}

.unitygit-split {
    flex-grow: 1;
    flex-direction: row;
}

#unitygit-nav {
    width: 150px;
    flex-shrink: 0;
    padding-top: var(--ed-space-1);
    padding-bottom: var(--ed-space-1);
}

.unitygit-nav-row {
    flex-grow: 1;
    flex-direction: row;
    align-items: center;
    padding-left: var(--ed-space-3);
    padding-right: var(--ed-space-2);
}

.unitygit-nav-label {
    flex-grow: 1;
    flex-shrink: 1;
    margin-left: 0;
    padding-left: 0;
    -unity-text-align: middle-left;
}

.unitygit-window .unity-collection-view__item--selected .unitygit-nav-label {
    -unity-font-style: bold;
}

#unitygit-panel {
    flex-grow: 1;
    flex-shrink: 1;
    margin-left: var(--ed-space-2);
}

/* Panels */

.unitygit-panel-content {
    flex-grow: 1;
    flex-shrink: 1;
}

.unitygit-scroll {
    flex-grow: 1;
    margin-bottom: var(--ed-space-2);
}

.unitygit-window .ed-card.unitygit-fill,
.unitygit-window .ed-table.unitygit-fill {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 88px;
}

.unitygit-window .ed-table.unitygit-fill {
    margin-bottom: var(--ed-space-2);
}

.unitygit-window .unitygit-list-card > .ed-card__content {
    flex-grow: 1;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
}

.unitygit-window .unitygit-header-only > .ed-card__header {
    border-bottom-width: 0;
}

.unitygit-list {
    flex-grow: 1;
    flex-shrink: 1;
}

.unitygit-card-note {
    padding-left: var(--ed-space-3);
    padding-right: var(--ed-space-3);
    padding-top: var(--ed-space-2);
    padding-bottom: var(--ed-space-2);
}

/* Card lines (Overview) */

.unitygit-window .unitygit-inline {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
}

.unitygit-overview-branch-name {
    font-size: var(--ed-font-l);
    white-space: normal;
    padding-left: 0;
}

.unitygit-overview-sha {
    flex-shrink: 0;
    margin-right: var(--ed-space-1);
}

.unitygit-field {
    flex-direction: row;
    align-items: center;
    min-height: 20px;
    margin-bottom: 2px;
}

.unitygit-caption {
    width: 64px;
    flex-shrink: 0;
    padding-left: 0;
}

.unitygit-value {
    flex-grow: 1;
    flex-shrink: 1;
    white-space: normal;
    padding-left: 0;
}

/* List rows */

.unitygit-list-row {
    flex-grow: 1;
    flex-direction: row;
    align-items: center;
    overflow: hidden;
    padding-left: var(--ed-space-2);
    padding-right: var(--ed-space-2);
}

.unitygit-ellipsis {
    flex-shrink: 1;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}

.unitygit-path {
    -unity-text-overflow-position: start;
}

.unitygit-row-subject {
    flex-grow: 1;
    margin-left: var(--ed-space-2);
}

.unitygit-window .unitygit-list-row > .ed-badge {
    margin-left: var(--ed-space-1);
    margin-right: 0;
}

.unitygit-window .unitygit-list-row > .ed-chip,
.unitygit-window .unitygit-inline > .ed-chip {
    margin-left: var(--ed-space-1);
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 0;
}

.unitygit-window .unitygit-list-row > .unitygit-kind-badge {
    min-width: 20px;
    margin-left: var(--ed-space-1);
    margin-right: var(--ed-space-2);
    padding-left: 0;
    padding-right: 0;
}

.unitygit-change-path {
    flex-grow: 1;
}

.unitygit-branch-name {
    flex-shrink: 0;
}

.unitygit-branch-upstream {
    margin-left: var(--ed-space-1);
}

.unitygit-sha {
    width: 60px;
    flex-shrink: 0;
}

.unitygit-commit-author {
    max-width: 160px;
    margin-left: var(--ed-space-2);
}

.unitygit-commit-date {
    flex-shrink: 0;
    margin-left: var(--ed-space-2);
    -unity-text-align: middle-right;
}

.unitygit-pair-key {
    flex-shrink: 0;
}

.unitygit-pair-owner {
    max-width: 40%;
    margin-left: var(--ed-space-2);
}

/* Authors: kit table columns */

.unitygit-window .ed-table__cell.unitygit-col-name {
    flex-grow: 2;
}

.unitygit-window .ed-table__cell.unitygit-col-email {
    flex-grow: 3;
}

.unitygit-window .ed-table__cell.unitygit-col-count {
    flex-grow: 0;
    flex-shrink: 0;
    flex-basis: 80px;
}

/* Changes: the header row, a kit table header lined up with the rows below it: the same side padding and Toggle,
   then "File" where the kind badge starts, and the summary on the right. */

.unitygit-window .unitygit-changes-header {
    flex-shrink: 0;
    padding-left: var(--ed-space-2);
    padding-right: var(--ed-space-2);
}

.unitygit-window .unitygit-changes-file {
    flex-grow: 1;
    flex-shrink: 1;
    margin-left: var(--ed-space-1);
    padding-left: 0;
    -unity-text-align: middle-left;
}

.unitygit-window .unitygit-changes-summary {
    flex-shrink: 0;
    padding-right: 0;
    -unity-text-align: middle-right;
}

/* Changes: the commit card */

.unitygit-window .unitygit-commit-message {
    min-height: 54px;
    margin-left: 0;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: var(--ed-space-2);
}

.unitygit-commit-message > .unity-base-text-field__input {
    white-space: normal;
}

.unitygit-commit-actions {
    flex-direction: row;
    justify-content: flex-end;
}

.unitygit-window .unitygit-commit-actions > .unity-button {
    min-width: 96px;
    margin-right: 0;
}

/* Conflicts: a header card, the file list (a short card of fixed height) and the selected file's card, which fills the
   rest. The file's places sit in a dark, code-like scroll area: unchanged context lines, then each place as a block whose
   left edge says whether it has a pick (warning: not chosen; success: chosen). The selected place is outlined in the
   accent and shows the two sides and the pick buttons. These rules come last so they win ties with the panel rules. */

.unitygit-window .unitygit-conflicts-header > .ed-card__content {
    padding-top: var(--ed-space-2);
    padding-bottom: var(--ed-space-2);
}

.unitygit-conflicts-headline {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
}

.unitygit-conflicts-title {
    flex-shrink: 0;
    font-size: var(--ed-font-l);
    padding-left: 0;
    margin-right: var(--ed-space-2);
}

.unitygit-conflicts-summary {
    flex-grow: 1;
    flex-shrink: 1;
    padding-left: 0;
}

.unitygit-window .unitygit-conflicts-headline > .unity-button {
    margin-left: var(--ed-space-1);
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 0;
}

.unitygit-conflicts-note {
    white-space: normal;
    padding-left: 0;
    padding-right: 0;
    margin-top: var(--ed-space-1);
}

.unitygit-window .ed-card.unitygit-conflicts-files-card {
    flex-grow: 0;
    flex-shrink: 0;
    height: 122px;
    min-height: 0;
}

.unitygit-conflicts-path {
    flex-grow: 1;
}

.unitygit-window .unitygit-conflict-file > .ed-card__content {
    flex-grow: 1;
    flex-shrink: 1;
    padding-bottom: var(--ed-space-2);
}

.unitygit-conflict-file-title {
    flex-shrink: 0;
    padding-left: 0;
}

.unitygit-conflict-file-type {
    flex-shrink: 0;
    padding-left: 0;
    margin-bottom: var(--ed-space-2);
}

.unitygit-conflict-whole-file {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    margin-bottom: var(--ed-space-2);
}

.unitygit-conflict-whole-file-caption {
    flex-shrink: 0;
    padding-left: 0;
    margin-right: var(--ed-space-1);
}

.unitygit-conflict-options {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    flex-shrink: 1;
}

.unitygit-window .unitygit-conflict-options > .unity-button {
    margin-left: 0;
    margin-right: var(--ed-space-1);
    margin-top: 2px;
    margin-bottom: 2px;
}

/* The picked option: filled in the success green (the green of a chosen place). The hover rule is needed: the kit's
   .ed-root .unity-button:hover:enabled is more specific than the rule above and would win while the pointer is over it. */
.unitygit-window .unity-button.unitygit-conflict-option--picked,
.unitygit-window .unity-button.unitygit-conflict-option--picked:hover:enabled {
    color: var(--ed-text-on-accent);
    background-color: var(--ed-success);
    border-color: var(--ed-success);
}

.unitygit-conflict-places {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 60px;
    margin-bottom: var(--ed-space-2);
    padding-top: 2px;
    padding-bottom: 2px;
    background-color: var(--ed-input-bg);
    border-width: 1px;
    border-color: var(--ed-border);
    border-radius: var(--ed-radius-s);
}

/* File text: monospace (the kit's mono class), kept as typed, wrapped only where the panel is too narrow. */
.unitygit-conflict-code {
    white-space: pre-wrap;
    font-size: var(--ed-font-s);
    margin-left: 0;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 0;
    padding-left: var(--ed-space-2);
    padding-right: var(--ed-space-2);
    padding-top: 0;
    padding-bottom: 0;
}

.unitygit-conflict-context {
    color: var(--ed-text-muted);
}

/* One line of the file: its number, then its text. A line that wraps keeps its number beside its first row. */
.unitygit-conflict-row {
    flex-direction: row;
    align-items: flex-start;
    flex-shrink: 0;
}

.unitygit-window .unitygit-conflict-row > .unitygit-conflict-code {
    flex-grow: 1;
    flex-shrink: 1;
}

/* The number column. Its width, and its place left of the place boxes, are set in ConflictsPanel (GutterWidth,
   PlaceInset), which mirrors the padding here and the place and side borders below. */
.unitygit-conflict-line-number {
    flex-shrink: 0;
    -unity-text-align: upper-right;
    color: var(--ed-text-faint);
    font-size: var(--ed-font-s);
    margin-left: 0;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 0;
    padding-left: 0;
    padding-right: 6px;
    padding-top: 0;
    padding-bottom: 0;
}

.unitygit-conflict-collapsed,
.unitygit-conflict-more,
.unitygit-conflict-no-lines {
    -unity-font-style: italic;
    padding-left: var(--ed-space-2);
    padding-top: 1px;
    padding-bottom: 1px;
}

/* ConflictsPanel replaces margin-left inline (number column + 4px) and its PlaceInset mirrors margin, border and padding. */
.unitygit-conflict-place {
    flex-shrink: 0;
    margin-left: var(--ed-space-1);
    margin-right: var(--ed-space-1);
    margin-top: 2px;
    margin-bottom: 2px;
    padding-left: var(--ed-space-2);
    padding-right: var(--ed-space-2);
    padding-top: var(--ed-space-1);
    padding-bottom: var(--ed-space-1);
    background-color: var(--ed-surface);
    border-left-width: 3px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--ed-warning);
    border-right-color: var(--ed-border);
    border-top-color: var(--ed-border);
    border-bottom-color: var(--ed-border);
    border-radius: var(--ed-radius-s);
}

.unitygit-conflict-place:hover {
    background-color: var(--ed-surface-hover);
}

.unitygit-conflict-place.unitygit-conflict-place--chosen {
    border-left-color: var(--ed-success);
}

.unitygit-conflict-place.unitygit-conflict-place--selected {
    background-color: var(--ed-surface-2);
    border-right-color: var(--ed-accent-border);
    border-top-color: var(--ed-accent-border);
    border-bottom-color: var(--ed-accent-border);
}

.unitygit-conflict-place-header {
    flex-direction: row;
    align-items: center;
}

.unitygit-window .unitygit-conflict-place-header > .ed-chip {
    margin-right: 0;
    margin-bottom: 0;
}

.unitygit-conflict-place-detail {
    margin-top: var(--ed-space-1);
}

.unitygit-conflict-side,
.unitygit-conflict-preview-box {
    margin-top: 2px;
    margin-bottom: 2px;
    padding-bottom: 2px;
    background-color: var(--ed-input-bg);
    border-left-width: 2px;
    border-radius: var(--ed-radius-s);
}

.unitygit-conflict-side--ours {
    border-left-color: var(--ed-info);
}

.unitygit-conflict-side--base {
    border-left-color: var(--ed-neutral);
}

.unitygit-conflict-side--theirs {
    border-left-color: var(--ed-accent);
}

/* The sides the selected place's pick uses, and the ones it leaves out. The wider edge takes its extra pixel from the
   margin, so the text doesn't move when a pick is made. */
.unitygit-conflict-side.unitygit-conflict-side--used {
    border-left-color: var(--ed-success);
    border-left-width: 3px;
    margin-left: -1px;
}

.unitygit-conflict-side.unitygit-conflict-side--unused {
    opacity: 0.5;
}

.unitygit-conflict-preview-box {
    margin-top: var(--ed-space-1);
    padding-top: 2px;
    border-left-color: var(--ed-success);
}

.unitygit-conflict-side-caption {
    padding-left: var(--ed-space-2);
    padding-top: 2px;
    padding-bottom: 0;
}

.unitygit-window .unitygit-conflict-place-detail > .unitygit-conflict-options {
    margin-top: var(--ed-space-1);
}

.unitygit-conflict-actions {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
}

.unitygit-window .unitygit-conflict-actions > .unity-button {
    margin-left: 0;
    margin-right: var(--ed-space-1);
    margin-top: 0;
    margin-bottom: 0;
}

.unitygit-window .unitygit-conflict-actions > #unitygit-conflict-apply {
    min-width: 96px;
    margin-right: 0;
}
